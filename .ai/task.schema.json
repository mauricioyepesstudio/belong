{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Ops Task",
  "type": "object",
  "required": ["id","title","project","status","owner_agent","objective","acceptance_criteria","evidence_required","escalation_triggers"],
  "properties": {
    "id": {"type":"string"},
    "title": {"type":"string"},
    "project": {"const":"belong"},
    "status": {"enum":["queued","running","review","approved","rework","blocked","owner-decision","done"]},
    "owner_agent": {"type":"string"},
    "reviewer_agent": {"type":["string","null"]},
    "objective": {"type":"string"},
    "dependencies": {"type":"array","items":{"type":"string"}},
    "allowed_paths": {"type":"array","items":{"type":"string"}},
    "acceptance_criteria": {"type":"array","minItems":1,"items":{"type":"string"}},
    "verification_commands": {"type":"array","items":{"type":"string"}},
    "evidence_required": {"type":"array","minItems":1,"items":{"type":"string"}},
    "evidence": {"type":"array","items":{"type":"string"}},
    "rollback_note": {"type":["string","null"]},
    "escalation_triggers": {"type":"array","minItems":1,"items":{"type":"string"}},
    "review_verdict": {"enum":["pending","approved","rejected"]}
  },
  "additionalProperties": false
}
