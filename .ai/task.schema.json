{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BELONG AI Ops Task",
  "type": "object",
  "required": ["id","title","project","status","owner_agent","reviewer_agent","objective","dependencies","allowed_paths","acceptance_criteria","verification_commands","evidence_required","rollback_note","escalation_triggers","risk_level","external_actions","production_impact","review_verdict"],
  "properties": {
    "id": {"type":"string","minLength":1},
    "title": {"type":"string","minLength":1},
    "project": {"const":"belong"},
    "status": {"enum":["queued","running","review","approved","rework","blocked","owner-decision","done"]},
    "owner_agent": {"type":"string","minLength":1},
    "reviewer_agent": {"type":["string","null"]},
    "objective": {"type":"string","minLength":1},
    "dependencies": {"type":"array","items":{"type":"string"}},
    "allowed_paths": {"type":"array","minItems":1,"items":{"type":"string"}},
    "acceptance_criteria": {"type":"array","minItems":1,"items":{"type":"string"}},
    "verification_commands": {"type":"array","minItems":1,"items":{"type":"string"}},
    "evidence_required": {"type":"array","minItems":1,"items":{"type":"string"}},
    "evidence": {"type":"array","items":{"type":"string"}},
    "rollback_note": {"type":["string","null"]},
    "escalation_triggers": {"type":"array","minItems":1,"items":{"type":"string"}},
    "risk_level": {"enum":["low","medium","high","critical"]},
    "external_actions": {"type":"array","items":{"type":"string"}},
    "production_impact": {"type":"boolean"},
    "review_verdict": {"enum":["pending","approved","rejected"]}
  },
  "allOf": [
    {"if":{"properties":{"status":{"const":"done"}}},"then":{"properties":{"review_verdict":{"const":"approved"},"evidence":{"minItems":1}},"required":["evidence"]}},
    {"if":{"properties":{"production_impact":{"const":true}}},"then":{"properties":{"status":{"enum":["owner-decision","approved","done"]}}}}
  ],
  "additionalProperties": false
}
