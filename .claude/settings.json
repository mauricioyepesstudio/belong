{
  "extraKnownMarketplaces": {
    "equipos-rge": {
      "source": {
        "source": "directory",
        "path": "./.claude/equipos"
      }
    }
  },
  "enabledPlugins": {
    "marketing-skills@equipos-rge": true,
    "social-media-skills@equipos-rge": true,
    "taste-skill@equipos-rge": true,
    "diseno-frontend@equipos-rge": true,
    "documentos@equipos-rge": true,
    "financial-analysis@equipos-rge": true,
    "commercial-legal@equipos-rge": true,
    "privacy-legal@equipos-rge": true,
    "ai-governance-legal@equipos-rge": true,
    "ip-legal@equipos-rge": true,
    "product-legal@equipos-rge": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/mods/guardia.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/mods/parte.mjs\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$CLAUDE_PROJECT_DIR/.claude/mods/linea.mjs\""
  },
  "enabledMcpjsonServers": [
    "supabase",
    "vercel",
    "playwright"
  ]
}
