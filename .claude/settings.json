{
  "extraKnownMarketplaces": {
    "equipos-rge": {
      "source": {
        "source": "directory",
        "path": "./.claude/equipos"
      }
    }
  },
  "enabledPlugins": {
    "ponytail@equipos-rge": true,
    "marketing-skills@equipos-rge": true,
    "social-media-skills@equipos-rge": true,
    "taste-skill@equipos-rge": true,
    "diseno-frontend@equipos-rge": true,
    "documentos@equipos-rge": true,
    "financial-analysis@equipos-rge": true,
    "commercial-legal@equipos-rge": true,
    "privacy-legal@equipos-rge": true,
    "ai-governance-legal@equipos-rge": true,
    "ip-legal@equipos-rge": true,
    "product-legal@equipos-rge": true,
    "tiktok-video-skills@equipos-rge": true,
    "ad-video-skills@equipos-rge": true,
    "explainer-video-skills@equipos-rge": true,
    "web-animation-skills@equipos-rge": true,
    "data-animation-skills@equipos-rge": true,
    "freelance-motion-skills@equipos-rge": true,
    "motion-design-skills@equipos-rge": true,
    "text-message-video-skills@equipos-rge": true,
    "youtube-video-skills@equipos-rge": true,
    "ecommerce-video-skills@equipos-rge": true,
    "map-animation-skills@equipos-rge": true,
    "kinetic-typography-skills@equipos-rge": true,
    "webgl-animation-skills@equipos-rge": true,
    "manim-skills@equipos-rge": true,
    "generative-illustration-skills@equipos-rge": true,
    "javascript-animation-skills@equipos-rge": true,
    "lower-thirds-skills@equipos-rge": true,
    "b-roll-skills@equipos-rge": true,
    "talking-head-skills@equipos-rge": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/mods/guardia.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/mods/parte.mjs\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$CLAUDE_PROJECT_DIR/.claude/mods/linea.mjs\""
  },
  "enabledMcpjsonServers": [
    "supabase",
    "vercel",
    "playwright"
  ]
}
